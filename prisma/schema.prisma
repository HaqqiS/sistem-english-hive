// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    directUrl = env("DIRECT_URL")
    url       = env("DATABASE_URL")
}

// test trpc
model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([createdById])
    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
    @@index([userId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

enum UserRole {
    GURU
    ADMIN
}

model User {
    id       String   @id @default(cuid())
    name     String?
    email    String?  @unique
    image    String?
    password String?
    role     UserRole @default(GURU)

    cabangId String?
    cabang   Cabang? @relation(fields: [cabangId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    accounts Account[]
    sessions Session[]
    posts    Post[]

    absensiGurus            AbsensiGuru[]      @relation("guruRelation")
    absenDiverifikasis      AbsensiGuru[]      @relation("verifiedByRelation")
    pembayaranDiverifikasis Pembayaran[]
    historyGuruKelases      HistoryGuruKelas[]
    Kelas                   Kelas[]

    @@index([role])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Cabang {
    id         String @id @default(cuid())
    namaCabang String
    alamat     String
    noTelp     String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    staffs User[]
    murids Murid[]
    ruangs Ruang[]
}

model Ruang {
    id        String  @id @default(cuid())
    namaRuang String
    isAktif   Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    cabangId String
    cabang   Cabang @relation(fields: [cabangId], references: [id])

    jadwalSesis SesiPertemuanKelas[]

    @@unique([cabangId, namaRuang])
    @@index([cabangId])
    @@index([namaRuang])
}

enum Gender {
    LAKI_LAKI
    PEREMPUAN
}

enum StatusMurid {
    AKTIF //masih aktif
    NON_AKTIF // sudah tidak aktif(tidak kursus lagi)
}

model Murid {
    id             String      @id @default(cuid())
    namaLengkap    String
    email          String      @unique
    alamat         String
    gender         Gender
    umur           Int
    asalSekolah    String
    kelasSekolah   String
    jamPulang      String //HH:mm
    noWA           String      @unique
    pilihanProgram String?
    sumberInfo     String
    statusMurid    StatusMurid @default(NON_AKTIF)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    cabangId String
    cabang   Cabang @relation(fields: [cabangId], references: [id])

    absensiMurids      AbsensiMurid[]
    pendaftaranKelases PendaftaranKelas[]
    pembayarans        Pembayaran[]

    @@index([cabangId])
    @@index([namaLengkap])
    @@index([statusMurid])
}

enum TipeKelas {
    REGULAR
    PRIVATE
}

enum JenisKelas {
    TinyTods
    PreLittleStar
    LittleStar
    RisingStar
    PreShiningStar
    ShiningStar
    Elementary
}

model Kelas {
    id             String     @id @default(cuid())
    jenisKelas     JenisKelas // e.g., "Rising Star", "Tiny Tod's"
    level          Int // e.g., 1, 2, 3
    tipe           TipeKelas // BARU: REGULAR atau PRIVATE
    grup           String? // BARU: "A", "B", atau null (opsional)
    bulanTahunAjar String     @db.VarChar(7) // format: "MM/YYYY", e.g., "08/2025"
    deskripsi      String?
    hargaKelas     Int
    kodeKelas      String // e.g., "TinyTods 1-A|reguler|03/2025"
    // historyGuru    String? // catatan pergantian guru untuk kelas ini

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sesiPertemuanKelases SesiPertemuanKelas[]
    pendaftaranKelases   PendaftaranKelas[]
    pembayarans          Pembayaran[]
    historyGuruKelases   HistoryGuruKelas[]
    User                 User?                @relation(fields: [userId], references: [id])
    userId               String?

    @@index([kodeKelas])
    @@index([level])
    @@index([bulanTahunAjar])
}

enum EnumStatusGuru {
    ACTIVE
    INACTIVE
}

model HistoryGuruKelas {
    id          String         @id @default(cuid())
    kelasId     String
    guruId      String
    mulaiPada   String         @db.VarChar(10) // format: "YYYY-MM-DD"
    selesaiPada String?        @db.VarChar(10) // format: "YYYY-MM-DD"
    statusGuru  EnumStatusGuru // "ACTIVE" atau "INACTIVE"

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
    guru  User  @relation(fields: [guruId], references: [id], onDelete: Restrict)

    @@index([kelasId])
    @@index([guruId])
}

model SesiPertemuanKelas {
    id           String   @id @default(cuid())
    kelasId      String
    ruangId      String
    tanggalWaktu DateTime
    // tanggalWaktu String @db.VarChar(19) // format: "YYYY-MM-DD HH:mm:ss"

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
    ruang Ruang @relation(fields: [ruangId], references: [id], onDelete: Restrict)

    absensiMurids AbsensiMurid[]
    absensiGurus  AbsensiGuru[]

    @@index([kelasId])
    @@index([ruangId])
    @@index([tanggalWaktu])
}

enum StatusAbsenMurid {
    HADIR
    ALPA
    OFF_SEMENTARA
}

model AbsensiMurid {
    id                   String           @id @default(cuid())
    muridId              String
    sesiPertemuanKelasId String
    status               StatusAbsenMurid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    murid              Murid              @relation(fields: [muridId], references: [id], onDelete: Cascade)
    sesiPertemuanKelas SesiPertemuanKelas @relation(fields: [sesiPertemuanKelasId], references: [id], onDelete: Cascade)

    // Mencegah murid punya >1 record di sesi yang sama
    @@unique([muridId, sesiPertemuanKelasId])
    // Anda tetap perlu indeks biasa untuk FK (untuk performa JOIN)
    @@index([muridId])
    @@index([sesiPertemuanKelasId])
}

enum StatusAbsenGuru {
    HADIR
    ALPA
    SAKIT
    IJIN
}

model AbsensiGuru {
    id                   String          @id @default(cuid())
    guruId               String
    sesiPertemuanKelasId String
    status               StatusAbsenGuru
    isVerified           Boolean         @default(false)
    verifiedById         String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    guru               User               @relation("guruRelation", fields: [guruId], references: [id], onDelete: Restrict)
    sesiPertemuanKelas SesiPertemuanKelas @relation(fields: [sesiPertemuanKelasId], references: [id], onDelete: Cascade)
    verifiedBy         User?              @relation("verifiedByRelation", fields: [verifiedById], references: [id], onDelete: SetNull)

    @@unique([guruId, sesiPertemuanKelasId])
    @@index([guruId])
    @@index([sesiPertemuanKelasId])
    @@index([verifiedById])
}

model PendaftaranKelas {
    id           String  @id @default(cuid())
    muridId      String
    kelasId      String
    tanggalMulai String  @db.VarChar(10) // format: "YYYY-MM-DD"
    isAktif      Boolean @default(true) //false jika murid sudah tidak ikut kelas ini lagi/ kelas selesai

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    murid Murid @relation(fields: [muridId], references: [id], onDelete: Cascade)
    Kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)

    @@index([muridId])
    @@index([kelasId])
    @@index([isAktif])
}

enum StatusPembayaran {
    LUNAS
    BELUM_LUNAS
    PENDING
}

model Pembayaran {
    id           String           @id @default(cuid())
    muridId      String
    kelasId      String
    pembayaranKe Int
    jumlahBayar  Int
    tanggalBayar DateTime?
    imageUrl     String?
    statusBayar  StatusPembayaran @default(BELUM_LUNAS)
    note         String?

    verifiedById String? // ID Admin yang memverifikasi
    verifiedBy   User?   @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    murid Murid @relation(fields: [muridId], references: [id], onDelete: Cascade)
    Kelas Kelas @relation(fields: [kelasId], references: [id], onDelete: Restrict)

    @@index([muridId])
    @@index([kelasId])
    @@index([statusBayar])
    @@index([verifiedById])
}
