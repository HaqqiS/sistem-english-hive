generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                       String             @id @default(cuid())
  name                     String?
  email                    String?            @unique
  image                    String?
  password                 String?
  role                     UserRole           @default(GURU)
  cabangId                 String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  absensiGurus             AbsensiGuru[]      @relation("guruRelation")
  absenDiverifikasis       AbsensiGuru[]      @relation("verifiedByRelation")
  accounts                 Account[]
  historyGuruKelases       HistoryGuruKelas[]
  pembayaranDiverifikasis  Pembayaran[]
  sessions                 Session[]
  tagihanLainDiverifikasis TagihanLain[]
  cabang                   Cabang?            @relation(fields: [cabangId], references: [id])
  penerimaBukusAsGuru      PenerimaBukuGuru[] @relation("PenerimaBukuGuru")

  @@index([role])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cabang {
  id            String            @id @default(cuid())
  namaCabang    String            @unique
  alamat        String
  noTelp        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  atasNama      String?
  bank          String?
  noRekening    String?
  email         String?
  jamSlotTetaps JamSlotTetap[]
  kelas         Kelas[]
  murids        Murid[]
  ruangs        Ruang[]
  staffs        User[]
  jenisKelases  JenisKelasModel[]
  stokBukus     StokBuku[]
}

model Ruang {
  id                 String               @id @default(cuid())
  namaRuang          String
  isAktif            Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  cabangId           String
  jadwalKelases      JadwalKelas[]
  cabang             Cabang               @relation(fields: [cabangId], references: [id])
  sesiPertemuanKelas SesiPertemuanKelas[]

  @@unique([cabangId, namaRuang])
  @@index([cabangId])
  @@index([namaRuang])
}

model JamSlotTetap {
  id            String        @id @default(cuid())
  cabangId      String
  namaSlot      String
  jamMulai      String        @db.VarChar(5)
  jamSelesai    String        @db.VarChar(5)
  jadwalKelases JadwalKelas[]
  cabang        Cabang        @relation(fields: [cabangId], references: [id], onDelete: Cascade)

  @@index([cabangId])
}

model JamSlotCustom {
  id            String        @id @default(cuid())
  jamMulai      String        @db.VarChar(5)
  jamSelesai    String        @db.VarChar(5)
  jadwalKelases JadwalKelas[]

  @@unique([jamMulai, jamSelesai])
}

model JadwalKelas {
  id                   String               @id @default(cuid())
  kelasId              String
  ruangId              String
  hari                 Hari
  jamSlotTetapId       String?
  jamSlotCustomId      String?
  jamSlotCustom        JamSlotCustom?       @relation(fields: [jamSlotCustomId], references: [id], onDelete: Cascade)
  jamSlotTetap         JamSlotTetap?        @relation(fields: [jamSlotTetapId], references: [id], onDelete: Restrict)
  kelas                Kelas                @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  ruang                Ruang                @relation(fields: [ruangId], references: [id])
  sesiPertemuanKelases SesiPertemuanKelas[]

  @@index([kelasId])
  @@index([ruangId])
  @@index([hari])
  @@index([jamSlotTetapId])
  @@index([jamSlotCustomId])
}

model Murid {
  id                 String             @id @default(cuid())
  namaLengkap        String
  gender             Gender
  umur               Int
  asalSekolah        String
  kelasSekolah       String
  noWA               String
  pilihanProgram     String?
  sumberInfo         String
  statusMurid        StatusMurid        @default(PENDAFTAR_BARU)
  deskripsi          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cabangId           String
  instagram          String?
  absensiMurids      AbsensiMurid[]
  cabang             Cabang             @relation(fields: [cabangId], references: [id])
  pendaftaranKelases PendaftaranKelas[]
  tagihanLains       TagihanLain[]
  penerimaBukus      PenerimaBuku[]

  @@index([cabangId])
  @@index([namaLengkap])
  @@index([statusMurid])
  @@index([noWA])
}

model JenisKelasModel {
  id          String           @id @default(cuid())
  nama        String
  tipe        TipeKelas
  harga       Int
  deskripsi   String?
  nextLevelId String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  hargaBuku   Int              @default(120000)
  cabangId    String?
  kelas       Kelas[]
  cabang      Cabang?          @relation(fields: [cabangId], references: [id])
  nextLevel   JenisKelasModel? @relation("Progression", fields: [nextLevelId], references: [id])
  prevLevel   JenisKelasModel? @relation("Progression")
  stokBukus   StokBuku[]

  @@unique([cabangId, tipe, nama])
  @@map("master_jenis_kelas")
}

model StokBuku {
  id            String          @id @default(cuid())
  jenisKelasId  String
  cabangId      String
  level         Int
  jumlahStok    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  penerimaBukus PenerimaBuku[]
  cabang        Cabang          @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  jenisKelas    JenisKelasModel @relation(fields: [jenisKelasId], references: [id], onDelete: Cascade)

  @@unique([jenisKelasId, cabangId, level])
  @@index([cabangId])
  @@map("stok_buku")
}

model PenerimaBuku {
  id           String               @id @default(cuid())
  stokBukuId   String
  muridId      String
  status       StatusPenerimaanBuku @default(BELUM_DIAMBIL)
  tanggalAmbil DateTime?
  catatan      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  kelasId      String?
  statusOrder  StatusOrderBuku2     @default(DIORDER)
  tanggalReady DateTime?
  kelas        Kelas?               @relation(fields: [kelasId], references: [id])
  murid        Murid                @relation(fields: [muridId], references: [id], onDelete: Cascade)
  stokBuku     StokBuku             @relation(fields: [stokBukuId], references: [id], onDelete: Cascade)
  guruPenerima PenerimaBukuGuru[]

  @@unique([stokBukuId, muridId])
  @@index([muridId])
  @@index([kelasId])
  @@map("penerima_buku")
}

model PenerimaBukuGuru {
  id             String       @id @default(cuid())
  penerimaBukuId String
  guruId         String
  guru           User         @relation("PenerimaBukuGuru", fields: [guruId], references: [id], onDelete: Cascade)
  penerimaBuku   PenerimaBuku @relation(fields: [penerimaBukuId], references: [id], onDelete: Cascade)

  @@unique([penerimaBukuId, guruId])
  @@index([guruId])
  @@map("penerima_buku_guru")
}

model Kelas {
  id                   String               @id @default(cuid())
  level                Int
  grup                 String?
  bulanTahunAjar       String               @db.VarChar(7)
  deskripsi            String?
  hargaKelas           Int
  kodeKelas            String
  cohortId             String               @default(cuid())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  cabangId             String
  jenisKelasId         String?
  statusKelas          StatusKelas?         @default(RUNNING)
  statusOrderBuku      StatusOrderBuku      @default(BELUM_DIPROSES)
  historyGuruKelases   HistoryGuruKelas[]
  jadwalKelas          JadwalKelas[]
  cabang               Cabang               @relation(fields: [cabangId], references: [id])
  jenisKelasRel        JenisKelasModel?     @relation(fields: [jenisKelasId], references: [id])
  pendaftaranKelases   PendaftaranKelas[]
  sesiPertemuanKelases SesiPertemuanKelas[]
  tagihanLains         TagihanLain[]
  penerimaBukus        PenerimaBuku[]

  @@unique([cabangId, kodeKelas])
  @@index([kodeKelas])
  @@index([level])
  @@index([bulanTahunAjar])
  @@index([cabangId])
  @@index([jenisKelasId])
}

model HistoryGuruKelas {
  id          String         @id @default(cuid())
  kelasId     String
  guruId      String
  mulaiPada   String?        @db.VarChar(10)
  selesaiPada String?        @db.VarChar(10)
  statusGuru  EnumStatusGuru
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  guru        User           @relation(fields: [guruId], references: [id])
  kelas       Kelas          @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@index([kelasId])
  @@index([guruId])
}

model SesiPertemuanKelas {
  id             String         @id @default(cuid())
  kelasId        String
  ruangId        String
  tanggalWaktu   DateTime
  jadwalKelasId  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isSelesaiAbsen Boolean?       @default(false)
  absensiGurus   AbsensiGuru[]
  absensiMurids  AbsensiMurid[]
  jadwalKelas    JadwalKelas?   @relation(fields: [jadwalKelasId], references: [id])
  kelas          Kelas          @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  ruang          Ruang          @relation(fields: [ruangId], references: [id])

  @@index([kelasId])
  @@index([tanggalWaktu])
}

model AbsensiMurid {
  id                   String             @id @default(cuid())
  muridId              String
  sesiPertemuanKelasId String
  status               StatusAbsenMurid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  murid                Murid              @relation(fields: [muridId], references: [id], onDelete: Cascade)
  sesiPertemuanKelas   SesiPertemuanKelas @relation(fields: [sesiPertemuanKelasId], references: [id], onDelete: Cascade)

  @@unique([muridId, sesiPertemuanKelasId])
  @@index([muridId])
  @@index([sesiPertemuanKelasId])
}

model AbsensiGuru {
  id                   String             @id @default(cuid())
  guruId               String
  sesiPertemuanKelasId String
  status               StatusAbsenGuru
  isVerified           Boolean            @default(false)
  verifiedById         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  guru                 User               @relation("guruRelation", fields: [guruId], references: [id])
  sesiPertemuanKelas   SesiPertemuanKelas @relation(fields: [sesiPertemuanKelasId], references: [id], onDelete: Cascade)
  verifiedBy           User?              @relation("verifiedByRelation", fields: [verifiedById], references: [id])

  @@unique([guruId, sesiPertemuanKelasId])
  @@index([guruId])
  @@index([sesiPertemuanKelasId])
  @@index([verifiedById])
}

model PendaftaranKelas {
  id           String            @id @default(cuid())
  muridId      String
  kelasId      String
  tanggalMulai String?           @db.VarChar(10)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  status       StatusPendaftaran @default(AKTIF)
  pembayarans  Pembayaran[]
  Kelas        Kelas             @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  murid        Murid             @relation(fields: [muridId], references: [id], onDelete: Cascade)

  @@index([muridId])
  @@index([kelasId])
  @@index([status])
}

model Pembayaran {
  id                 String           @id @default(cuid())
  pendaftaranKelasId String
  pembayaranKe       Int
  tanggalJatuhTempo  DateTime
  jumlahBayar        Int
  tanggalBayar       DateTime?
  imageUrl           String?
  statusBayar        StatusPembayaran @default(BELUM_LUNAS)
  note               String?
  verifiedById       String?
  sudahDiingatkan    Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  pendaftaranKelas   PendaftaranKelas @relation(fields: [pendaftaranKelasId], references: [id], onDelete: Cascade)
  verifiedBy         User?            @relation(fields: [verifiedById], references: [id])

  @@unique([pendaftaranKelasId, pembayaranKe])
  @@index([pendaftaranKelasId])
  @@index([tanggalJatuhTempo])
  @@index([statusBayar])
  @@index([verifiedById])
}

model TagihanLain {
  id              String           @id @default(cuid())
  muridId         String
  kategori        KategoriTagihan
  judul           String
  deskripsi       String?
  jumlah          Int
  status          StatusPembayaran @default(BELUM_LUNAS)
  kelasId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tanggalBayar    DateTime?
  verifiedById    String?
  sudahDiingatkan Boolean          @default(false)
  kelas           Kelas?           @relation(fields: [kelasId], references: [id])
  murid           Murid            @relation(fields: [muridId], references: [id], onDelete: Cascade)
  verifiedBy      User?            @relation(fields: [verifiedById], references: [id])

  @@index([muridId])
  @@index([kelasId])
  @@index([verifiedById])
}

model FinalReport {
  id                   String            @id @default(cuid())
  studentName          String
  teacherName          String
  level                String
  midTest              Float
  finalTest            Float
  listening            Float
  speaking             Float
  reading              Float
  writing              Float
  recording            Int
  attendance           Int
  projectParticipation Float
  finalScore           Float
  notes                String?
  status               FinalReportStatus @default(PENDING)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  isPrinted            Boolean           @default(false)
  teacherUserId        String
  cabangAlamat         String?
  cabangNama           String?
  cabangNoTelp         String?
  cabangEmail          String?
  studentId            String?
  graduationDate       DateTime?
  reportType           String            @default("4-aspek")
}

enum UserRole {
  GURU
  ADMIN
  MANAGER
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusMurid {
  AKTIF
  NON_AKTIF
  LULUS
  TRIAL
  PENDING
  PLACEMENT_TEST
  ON_GOING
  WAITING_LIST
  TUNGGU_KONFIRMASI
  PENDAFTAR_BARU
  OFF_SEMENTARA
}

enum TipeKelas {
  REGULAR
  PRIVATE
}

enum StatusKelas {
  RUNNING
  WAITING
  TRIAL
  LEVEL_UP
  COMPLETED
}

enum StatusOrderBuku {
  BELUM_DIPROSES
  DIBATALKAN
  MENUNGGU_PERSETUJUAN
  SUDAH_DIPESAN
}

enum StatusPenerimaanBuku {
  BELUM_DIAMBIL
  SUDAH_DIAMBIL
}

enum StatusOrderBuku2 {
  DIORDER
  READY
}

enum EnumStatusGuru {
  ACTIVE
  INACTIVE
}

enum StatusAbsenMurid {
  HADIR
  ALPA
  OFF_SEMENTARA
}

enum StatusAbsenGuru {
  HADIR
  ALPA
  SAKIT
  IJIN
}

enum StatusPendaftaran {
  AKTIF
  NON_AKTIF
  TRIAL
  WAITING_LIST
  OFF_SEMENTARA
}

enum StatusPembayaran {
  LUNAS
  BELUM_LUNAS
  PENDING
}

enum KategoriTagihan {
  REGISTRASI
  BUKU
  LAINNYA
}

enum FinalReportStatus {
  PENDING
  APPROVED
  REJECTED
}